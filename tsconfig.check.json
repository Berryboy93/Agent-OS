{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@agent-os/core": ["./packages/core/src/index.ts"],
      "@agent-os/db": ["./packages/db/src/index.ts"],
      "@agent-os/events": ["./packages/events/src/index.ts"],
      "@agent-os/memory": ["./packages/memory/src/index.ts"],
      "@agent-os/adapters": ["./packages/adapters/src/index.ts"],
      "@agent-os/runtime": ["./packages/runtime/src/index.ts"]
    }
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/db/src/**/*.ts",
    "packages/events/src/**/*.ts",
    "packages/memory/src/**/*.ts",
    "packages/adapters/src/**/*.ts",
    "packages/runtime/src/**/*.ts",
    "packages/cli/src/**/*.ts",
    "apps/dashboard/server.ts"
  ]
}
