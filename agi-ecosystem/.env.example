# AGI Ecosystem Environment Configuration
NODE_ENV=production
AGI_ENV=production
LOG_LEVEL=info

# Event Store
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agi_events
POSTGRES_USER=agi_admin
POSTGRES_PASSWORD=change_me_in_production

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_PREFIX=agi

# Mythos Policy
MYTHOS_POLICY_PATH=./policies/default.policy
MYTHOS_RISK_THRESHOLD=0.7

# Swarm Runtime
SWARM_NODE_REPLICAS=3
SWARM_MAX_REPLICAS=20
SWARM_CPU_LIMIT=2000m
SWARM_MEMORY_LIMIT=4Gi

# Agent OS
AGENT_SANDBOX_TIMEOUT_MS=30000
AGENT_MAX_CONCURRENT_TASKS=10
