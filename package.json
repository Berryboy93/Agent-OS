{
  "name": "agent-os-ecosystem",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "tsc": "pnpm -r tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm -r lint",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
