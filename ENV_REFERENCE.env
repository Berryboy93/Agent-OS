# ════════════════════════════════════════════════════════
# ~/Agi-Suite/.env  (agent-runner app)
# ════════════════════════════════════════════════════════

# ── Agi-Suite DB ─────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/agi_suite_db

# ── R3v4 injection targets ───────────────────────────────
R3V4_TRPC_URL=http://localhost:3000/api/trpc
R3V4_WS_URL=ws://localhost:3000/ws/agent

# ── Service-to-service auth ──────────────────────────────
# Generate once: openssl rand -hex 32
# Must be identical in R3v4 .env
AGENT_SERVICE_TOKEN=REPLACE_WITH_OPENSSL_OUTPUT

# ── Worker tuning ────────────────────────────────────────
MAX_CONCURRENT_AGENTS=5
AGENT_POLL_INTERVAL_MS=5000
AGENT_STUCK_THRESHOLD_MS=30000
AGENT_POLL_BATCH_SIZE=10

# ════════════════════════════════════════════════════════
# ~/Stable/.env  (R3v4 additions — append to existing)
# ════════════════════════════════════════════════════════

# ── Service-to-service auth ──────────────────────────────
# Must match Agi-Suite AGENT_SERVICE_TOKEN exactly
AGENT_SERVICE_TOKEN=REPLACE_WITH_OPENSSL_OUTPUT

# ── WS ack mode (disable in prod for performance) ────────
AGENT_WS_ACK=false
