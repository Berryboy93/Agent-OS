function Badge({ status }: { status: string }) {
  const color = STATUS_COLOR[status] ?? '#8888aa';
  return (
    <span style={{
      display: 'inline-block',
      padding: '2px 8px',
      borderRadius: 4,
      fontSize: 11,
      fontWeight: 600,
      background: color + '22',
      color,
      letterSpacing: '0.04em',
      textTransform: 'uppercase',
    }}>
      {status}
    </span>
  );
}

function StatCard({ label, value, sub }: { label: string; value: string | number; sub?: string }) {
  return (
    <div style={{
      background: 'var(--bg2)',
      border: '1px solid var(--border)',
      borderRadius: 'var(--radius)',
      padding: '16px 20px',
      flex: 1,
      minWidth: 120,
    }}>
      <div style={{ color: 'var(--text2)', fontSize: 11, marginBottom: 4, textTransform: 'uppercase', letterSpacing: '0.06em' }}>{label}</div>
      <div style={{ fontSize: 24, fontWeight: 700, color: 'var(--accent2)' }}>{value}</div>
      {sub && <div style={{ color: 'var(--text2)', fontSize: 11, marginTop: 2 }}>{sub}</div>}
    </div>
  );
}

function RunRow({ run, selected, onClick }: { run: Run; selected: boolean; onClick: () => void }) {
  const dur = run.completed_at && run.started_at
    ? ((run.completed_at - run.started_at) / 1000).toFixed(1) + 's'
    : run.status === 'RUNNING' ? '…' : '—';

  return (
    <tr
      onClick={onClick}
      style={{
        cursor: 'pointer',
        background: selected ? 'var(--bg3)' : 'transparent',
        borderBottom: '1px solid var(--border)',
        transition: 'background 0.1s',
      }}
    >
      <td style={{ padding: '10px 16px', fontFamily: 'var(--font-mono)', fontSize: 12, color: 'var(--accent2)' }}>
        {run.id.slice(0, 8)}
      </td>
      <td style={{ padding: '10px 16px', color: 'var(--text2)', fontSize: 13 }}>{run.agent_id}</td>
      <td style={{ padding: '10px 16px' }}><Badge status={run.status} /></td>
      <td style={{ padding: '10px 16px', fontFamily: 'var(--font-mono)', fontSize: 12, color: 'var(--text2)' }}>
        {(run.total_tokens ?? 0).toLocaleString()}
      </td>
      <td style={{ padding: '10px 16px', fontFamily: 'var(--font-mono)', fontSize: 12, color: 'var(--text2)' }}>{dur}</td>
      <td style={{ padding: '10px 16px', fontSize: 12, color: 'var(--text2)' }}>
        {run.created_at ? new Date(run.created_at).toLocaleTimeString() : '—'}
      </td>
    </tr>
  );
}

function EventRow({ event }: { event: AgentEvent }) {
  const color = EVENT_COLOR[event.type] ?? '#8888aa';
  let data: Record<string, unknown> = {};
  try { data = JSON.parse(event.data_json) as Record<string, unknown>; } catch { /* empty */ }
  const preview = Object.keys(data).length > 0 ? JSON.stringify(data).slice(0, 100) : '';

  return (
    <tr style={{ borderBottom: '1px solid var(--border)' }}>
      <td style={{ padding: '8px 16px', fontFamily: 'var(--font-mono)', fontSize: 11, color: 'var(--text2)' }}>
        {event.timestamp ? new Date(event.timestamp).toISOString().slice(11, 23) : '—'}
      </td>
      <td style={{ padding: '8px 16px' }}>
        <span style={{
          fontFamily: 'var(--font-mono)', fontSize: 11, color,
          background: color + '18', padding: '2px 6px', borderRadius: 3,
        }}>{event.type}</span>
      </td>
      <td style={{ padding: '8px 16px', fontFamily: 'var(--font-mono)', fontSize: 11, color: 'var(--text2)', maxWidth: 300, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
        {preview}
      </td>
    </tr>
  );
}

function DeploymentsView({ deployments, onRefresh }: { deployments: Deployment[]; onRefresh: () => void }) {
  const [rolling, setRolling] = useState<string | null>(null);

  const handleRollback = async (id: string) => {
    if (!confirm(`Roll back deployment ${id.slice(0, 8)}?`)) return;
    setRolling(id);
    try {
      const r = await fetch(`${API}/deployments/${id}/rollback`, { method: 'POST' });
      if (!r.ok) {
        const err = await r.json() as { error: string };
        alert(`Rollback failed: ${err.error}`);
      }
      onRefresh();
    } catch (err) {
      alert(`Rollback failed: ${String(err)}`);
    } finally {
      setRolling(null);
    }
  };

  const createDemo = async () => {
    await fetch(`${API}/deployments/demo`, { method: 'POST' });
    onRefresh();
  };

  return (
    <div>
      <div style={{ padding: '16px 24px', borderBottom: '1px solid var(--border)', display: 'flex', alignItems: 'center', gap: 12 }}>
        <span style={{ color: 'var(--text2)', fontSize: 13 }}>Deployment history with rollback support</span>
        <button onClick={createDemo} style={{ marginLeft: 'auto', padding: '5px 12px', background: 'var(--accent)', color: '#fff', borderRadius: 5, fontSize: 12, fontWeight: 600 }}>
          + Demo Deployment
        </button>
      </div>
      <table style={{ width: '100%', borderCollapse: 'collapse' }}>
        <thead>
          <tr style={{ background: 'var(--bg2)', borderBottom: '1px solid var(--border)' }}>
            {['ID', 'Agent', 'Version', 'Status', 'Target', 'Deployed By', 'Created', 'Actions'].map(h => (
              <th key={h} style={{ padding: '10px 16px', textAlign: 'left', fontSize: 11, color: 'var(--text2)', fontWeight: 600, letterSpacing: '0.06em', textTransform: 'uppercase', whiteSpace: 'nowrap' }}>{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {deployments.length === 0 ? (
            <tr><td colSpan={8} style={{ padding: '48px 16px', textAlign: 'center', color: 'var(--text2)' }}>
              No deployments. Click <strong>+ Demo Deployment</strong> to create one.
            </td></tr>
          ) : deployments.map(dep => (
            <tr key={dep.id} style={{ borderBottom: '1px solid var(--border)' }}>
              <td style={{ padding: '10px 16px', fontFamily: 'var(--font-mono)', fontSize: 12, color: 'var(--accent2)' }}>{dep.id.slice(0, 8)}</td>
              <td style={{ padding: '10px 16px', fontSize: 13, color: 'var(--text2)' }}>{dep.agent_id}</td>
              <td style={{ padding: '10px 16px', fontFamily: 'var(--font-mono)', fontSize: 12 }}>v{dep.version}</td>
              <td style={{ padding: '10px 16px' }}><Badge status={dep.status} /></td>
              <td style={{ padding: '10px 16px', fontSize: 12, color: 'var(--text2)' }}>{dep.target}</td>
              <td style={{ padding: '10px 16px', fontSize: 12, color: 'var(--text2)' }}>{dep.deployed_by ?? '—'}</td>
              <td style={{ padding: '10px 16px', fontSize: 12, color: 'var(--text2)' }}>
                {new Date(dep.created_at).toLocaleString()}
              </td>
              <td style={{ padding: '10px 16px' }}>
                {dep.status === 'ACTIVE' && (
                  <button
                    onClick={() => void handleRollback(dep.id)}
                    disabled={rolling === dep.id}
                    style={{
                      padding: '3px 10px',
                      fontSize: 11,
                      fontWeight: 600,
                      color: '#f97316',
                      background: '#f9731611',
                      border: '1px solid #f9731644',
                      borderRadius: 4,
                      cursor: 'pointer',
                    }}
                  >
                    {rolling === dep.id ? '…' : 'Rollback'}
                  </button>
                )}
                {dep.rollback_of && (
                  <span style={{ fontSize: 10, color: 'var(--text2)' }}>↩ {dep.rollback_of.slice(0, 6)}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

function ApprovalsView({ approvals, onRefresh }: { approvals: ApprovalRequest[]; onRefresh: () => void }) {
  const [resolving, setResolving] = useState<string | null>(null);

  const resolve = async (id: string, decision: 'APPROVED' | 'REJECTED') => {
    setResolving(id);
    try {
      const r = await fetch(`${API}/approvals/${id}/resolve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ decision, resolvedBy: 'dashboard-user' }),
      });
      if (!r.ok) {
        const err = await r.json() as { error: string };
        alert(`Failed: ${err.error}`);
      }
      onRefresh();
    } catch (err) {
      alert(`Failed: ${String(err)}`);
    } finally {
      setResolving(null);
    }
  };

  const createDemo = async () => {
    await fetch(`${API}/approvals/demo`, { method: 'POST' });
    onRefresh();
  };

  const pending = approvals.filter(a => a.status === 'PENDING').length;

  return (
    <div>
      <div style={{ padding: '16px 24px', borderBottom: '1px solid var(--border)', display: 'flex', alignItems: 'center', gap: 12 }}>
        <span style={{ color: 'var(--text2)', fontSize: 13 }}>
          {pending > 0 ? <span style={{ color: '#f59e0b', fontWeight: 600 }}>⚠ {pending} pending approval{pending !== 1 ? 's' : ''} require action</span> : 'Approval queue — all clear'}
        </span>
        <button onClick={createDemo} style={{ marginLeft: 'auto', padding: '5px 12px', background: 'var(--accent)', color: '#fff', borderRadius: 5, fontSize: 12, fontWeight: 600 }}>
          + Demo Approval
        </button>
      </div>
      <table style={{ width: '100%', borderCollapse: 'collapse' }}>
        <thead>
          <tr style={{ background: 'var(--bg2)', borderBottom: '1px solid var(--border)' }}>
            {['ID', 'Execution', 'Step', 'Reason', 'Status', 'Expires', 'Resolved By', 'Actions'].map(h => (
              <th key={h} style={{ padding: '10px 16px', textAlign: 'left', fontSize: 11, color: 'var(--text2)', fontWeight: 600, letterSpacing: '0.06em', textTransform: 'uppercase', whiteSpace: 'nowrap' }}>{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {approvals.length === 0 ? (
            <tr><td colSpan={8} style={{ padding: '48px 16px', textAlign: 'center', color: 'var(--text2)' }}>
              No approval requests. Click <strong>+ Demo Approval</strong> to create one.
            </td></tr>
          ) : approvals.map(a => {
            const expired = a.expires_at && a.expires_at < Date.now();
            return (
              <tr key={a.id} style={{ borderBottom: '1px solid var(--border)', background: a.status === 'PENDING' && !expired ? '#f59e0b08' : 'transparent' }}>
                <td style={{ padding: '10px 16px', fontFamily: 'var(--font-mono)', fontSize: 12, color: 'var(--accent2)' }}>{a.id.slice(0, 8)}</td>
                <td style={{ padding: '10px 16px', fontFamily: 'var(--font-mono)', fontSize: 11, color: 'var(--text2)' }}>{a.execution_id.slice(0, 8)}</td>
                <td style={{ padding: '10px 16px', fontFamily: 'var(--font-mono)', fontSize: 11 }}>{a.step_id}</td>
                <td style={{ padding: '10px 16px', fontSize: 12, color: 'var(--text2)', maxWidth: 200, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{a.reason}</td>
                <td style={{ padding: '10px 16px' }}><Badge status={expired && a.status === 'PENDING' ? 'EXPIRED' : a.status} /></td>
                <td style={{ padding: '10px 16px', fontSize: 11, color: expired ? '#ef4444' : 'var(--text2)' }}>
                  {a.expires_at ? new Date(a.expires_at).toLocaleString() : '—'}
                </td>
                <td style={{ padding: '10px 16px', fontSize: 12, color: 'var(--text2)' }}>{a.resolved_by ?? '—'}</td>
                <td style={{ padding: '10px 16px', display: 'flex', gap: 6 }}>
                  {a.status === 'PENDING' && !expired && (
                    <>
                      <button
                        onClick={() => void resolve(a.id, 'APPROVED')}
                        disabled={resolving === a.id}
                        style={{ padding: '3px 10px', fontSize: 11, fontWeight: 600, color: '#22c55e', background: '#22c55e11', border: '1px solid #22c55e44', borderRadius: 4, cursor: 'pointer' }}
                      >
                        {resolving === a.id ? '…' : 'Approve'}
                      </button>
                      <button
                        onClick={() => void resolve(a.id, 'REJECTED')}
                        disabled={resolving === a.id}
                        style={{ padding: '3px 10px', fontSize: 11, fontWeight: 600, color: '#ef4444', background: '#ef444411', border: '1px solid #ef444444', borderRadius: 4, cursor: 'pointer' }}
                      >
                        Reject
                      </button>
                    </>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  );
}

