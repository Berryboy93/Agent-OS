type Tab = 'runs' | 'events' | 'pipelines' | 'deployments' | 'approvals';

export default function App() {
  const [tab, setTab] = useState<Tab>('runs');
  const [runs, setRuns] = useState<Run[]>([]);
  const [events, setEvents] = useState<AgentEvent[]>([]);
  const [pipelines, setPipelines] = useState<PipelineRun[]>([]);
  const [deployments, setDeployments] = useState<Deployment[]>([]);
  const [approvals, setApprovals] = useState<ApprovalRequest[]>([]);
  const [stats, setStats] = useState<Stats | null>(null);
  const [selectedRun, setSelectedRun] = useState<Run | null>(null);
  const [runEvents, setRunEvents] = useState<AgentEvent[]>([]);
  const [loading, setLoading] = useState(true);
  const [liveIndicator, setLiveIndicator] = useState(false);

  const fetchRuns = useCallback(async () => {
    try {
      const r = await fetch(`${API}/runs?limit=50`);
      if (r.ok) setRuns(await r.json() as Run[]);
    } catch { /* ignore */ }
  }, []);

  const fetchEvents = useCallback(async () => {
    try {
      const r = await fetch(`${API}/events?limit=100`);
      if (r.ok) setEvents(await r.json() as AgentEvent[]);
    } catch { /* ignore */ }
  }, []);

  const fetchPipelines = useCallback(async () => {
    try {
      const r = await fetch(`${API}/pipelines`);
      if (r.ok) setPipelines(await r.json() as PipelineRun[]);
    } catch { /* ignore */ }
  }, []);

  const fetchDeployments = useCallback(async () => {
    try {
      const r = await fetch(`${API}/deployments`);
      if (r.ok) setDeployments(await r.json() as Deployment[]);
    } catch { /* ignore */ }
  }, []);

  const fetchApprovals = useCallback(async () => {
    try {
      const r = await fetch(`${API}/approvals`);
      if (r.ok) setApprovals(await r.json() as ApprovalRequest[]);
    } catch { /* ignore */ }
  }, []);

  const fetchStats = useCallback(async () => {
    try {
      const r = await fetch(`${API}/stats`);
      if (r.ok) setStats(await r.json() as Stats);
    } catch { /* ignore */ }
  }, []);

  const fetchRunEvents = useCallback(async (runId: string) => {
    try {
      const r = await fetch(`${API}/runs/${runId}/events`);
      if (r.ok) setRunEvents(await r.json() as AgentEvent[]);
    } catch { /* ignore */ }
  }, []);

  const refreshAll = useCallback(async () => {
    await Promise.all([fetchRuns(), fetchStats(), fetchDeployments(), fetchApprovals(), fetchPipelines()]);
  }, [fetchRuns, fetchStats, fetchDeployments, fetchApprovals, fetchPipelines]);

  useEffect(() => {
    Promise.all([fetchRuns(), fetchEvents(), fetchStats(), fetchDeployments(), fetchApprovals(), fetchPipelines()])
      .finally(() => setLoading(false));
  }, [fetchRuns, fetchEvents, fetchStats, fetchDeployments, fetchApprovals, fetchPipelines]);

  useInterval(() => {
    void fetchRuns();
    void fetchStats();
    if (tab === 'approvals') void fetchApprovals();
    if (tab === 'deployments') void fetchDeployments();
    if (tab === 'pipelines') void fetchPipelines();
  }, 5000);

  useEffect(() => {
    const es = new EventSource(`${API}/sse`);
    es.onmessage = (e) => {
      try {
        JSON.parse(e.data);
        setLiveIndicator(true);
        setTimeout(() => setLiveIndicator(false), 800);
        void fetchRuns();
        void fetchStats();
        void fetchApprovals();
      } catch { /* ignore */ }
    };
    return () => es.close();
  }, [fetchRuns, fetchStats, fetchApprovals]);

  useEffect(() => {
    if (selectedRun) void fetchRunEvents(selectedRun.id);
  }, [selectedRun, fetchRunEvents]);

  const handleSelectRun = (run: Run) => {
    setSelectedRun(prev => prev?.id === run.id ? null : run);
  };

  const spawnDemo = async () => {
    await fetch(`${API}/runs/demo`, { method: 'POST' });
    await Promise.all([fetchRuns(), fetchStats(), fetchEvents()]);
  };

  const statusCounts = stats?.runs.byStatus ?? [];
  const getCount = (s: string) => statusCounts.find(x => x.status === s)?.count ?? 0;
  const pendingApprovals = stats?.approvals?.pending ?? 0;

  const TABS: Array<{ key: Tab; label: string; badge?: number }> = [
    { key: 'runs', label: 'Runs' },
    { key: 'events', label: 'Events' },
    { key: 'pipelines', label: 'Pipelines' },
    { key: 'deployments', label: 'Deployments' },
    { key: 'approvals', label: 'Approvals', badge: pendingApprovals > 0 ? pendingApprovals : undefined },
  ];

  return (
    <div style={{ display: 'flex', flexDirection: 'column', height: '100vh', overflow: 'hidden' }}>
      <header style={{
        background: 'var(--bg2)',
        borderBottom: '1px solid var(--border)',
        padding: '0 24px',
        display: 'flex',
        alignItems: 'center',
        gap: 16,
        height: 56,
        flexShrink: 0,
      }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
          <div style={{
            width: 30, height: 30, borderRadius: 6,
            background: 'var(--accent)', display: 'flex', alignItems: 'center', justifyContent: 'center',
            fontSize: 16, fontWeight: 700,
          }}>A</div>
          <div>
            <div style={{ fontWeight: 700, fontSize: 15, letterSpacing: '-0.01em' }}>Agent-OS</div>
            <div style={{ fontSize: 10, color: 'var(--text2)', letterSpacing: '0.04em' }}>v3.0.0 · M0</div>
          </div>
        </div>

        <div style={{ flex: 1 }} />

        <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
          <span style={{
            width: 8, height: 8, borderRadius: '50%',
            background: liveIndicator ? '#22c55e' : '#3f3f52',
            transition: 'background 0.3s',
            display: 'inline-block',
          }} />
          <span style={{ fontSize: 11, color: 'var(--text2)' }}>LIVE</span>
        </div>

        <button
          onClick={() => void spawnDemo()}
          style={{
            padding: '6px 14px',
            background: 'var(--accent)',
            color: '#fff',
            borderRadius: 6,
            fontSize: 13,
            fontWeight: 600,
          }}
        >
          + Demo Run
        </button>
      </header>

      <div style={{
        background: 'var(--bg)',
        borderBottom: '1px solid var(--border)',
        padding: '10px 24px',
        display: 'flex',
        gap: 10,
        flexShrink: 0,
        overflowX: 'auto',
      }}>
        <StatCard label="Total Runs" value={stats?.runs.total ?? 0} />
        <StatCard label="Completed" value={getCount('COMPLETED')} sub="successful" />
        <StatCard label="Failed" value={getCount('FAILED')} sub="errors" />
        <StatCard label="Running" value={getCount('RUNNING')} sub="active" />
        <StatCard label="Total Tokens" value={(stats?.tokens.total ?? 0).toLocaleString()} sub="all time" />
        <StatCard label="Events/h" value={stats?.events.lastHour ?? 0} sub="last hour" />
        <StatCard label="Approvals" value={pendingApprovals} sub="pending" />
        <StatCard label="Deployments" value={stats?.deployments?.active ?? 0} sub="active" />
      </div>

      <div style={{
        background: 'var(--bg2)',
        borderBottom: '1px solid var(--border)',
        padding: '0 24px',
        display: 'flex',
        gap: 0,
        flexShrink: 0,
      }}>
        {TABS.map(t => (
          <button
            key={t.key}
            onClick={() => setTab(t.key)}
            style={{
              padding: '12px 18px',
              fontSize: 13,
              fontWeight: 600,
              color: tab === t.key ? 'var(--accent2)' : 'var(--text2)',
              borderBottom: tab === t.key ? '2px solid var(--accent)' : '2px solid transparent',
              textTransform: 'capitalize',
              transition: 'color 0.15s',
              display: 'flex',
              alignItems: 'center',
              gap: 6,
            }}
          >
            {t.label}
            {t.badge !== undefined && (
              <span style={{
                background: '#f59e0b',
                color: '#000',
                borderRadius: 8,
                fontSize: 10,
                fontWeight: 700,
                padding: '1px 5px',
                minWidth: 16,
                textAlign: 'center',
              }}>{t.badge}</span>
            )}
          </button>
        ))}
      </div>

      <div style={{ display: 'flex', flex: 1, overflow: 'hidden' }}>
        <div style={{ flex: selectedRun && tab === 'runs' ? '0 0 55%' : 1, overflow: 'auto' }}>
          {loading ? (
            <div style={{ padding: 48, textAlign: 'center', color: 'var(--text2)' }}>Loading…</div>
          ) : tab === 'runs' ? (
            <table style={{ width: '100%', borderCollapse: 'collapse' }}>
              <thead>
                <tr style={{ background: 'var(--bg2)', borderBottom: '1px solid var(--border)' }}>
                  {['Run ID', 'Agent', 'Status', 'Tokens', 'Duration', 'Created'].map(h => (
                    <th key={h} style={{ padding: '10px 16px', textAlign: 'left', fontSize: 11, color: 'var(--text2)', fontWeight: 600, letterSpacing: '0.06em', textTransform: 'uppercase', whiteSpace: 'nowrap' }}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {runs.length === 0 ? (
                  <tr><td colSpan={6} style={{ padding: '48px 16px', textAlign: 'center', color: 'var(--text2)' }}>
                    No runs yet. Click <strong>+ Demo Run</strong> to create one.
                  </td></tr>
                ) : runs.map(run => (
                  <RunRow
                    key={run.id}
                    run={run}
                    selected={selectedRun?.id === run.id}
                    onClick={() => handleSelectRun(run)}
                  />
                ))}
              </tbody>
            </table>
          ) : tab === 'events' ? (
            <table style={{ width: '100%', borderCollapse: 'collapse' }}>
              <thead>
                <tr style={{ background: 'var(--bg2)', borderBottom: '1px solid var(--border)' }}>
                  {['Time', 'Event Type', 'Data'].map(h => (
                    <th key={h} style={{ padding: '10px 16px', textAlign: 'left', fontSize: 11, color: 'var(--text2)', fontWeight: 600, letterSpacing: '0.06em', textTransform: 'uppercase' }}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {events.length === 0 ? (
                  <tr><td colSpan={3} style={{ padding: '48px 16px', textAlign: 'center', color: 'var(--text2)' }}>No events yet.</td></tr>
                ) : events.map(ev => <EventRow key={ev.id} event={ev} />)}
              </tbody>
            </table>
          ) : tab === 'pipelines' ? (
            <PipelinesView pipelines={pipelines} />
          ) : tab === 'deployments' ? (
            <DeploymentsView deployments={deployments} onRefresh={() => void refreshAll()} />
          ) : (
            <ApprovalsView approvals={approvals} onRefresh={() => void refreshAll()} />
          )}
        </div>

        {selectedRun && tab === 'runs' && (
          <div style={{
            flex: '0 0 45%',
            background: 'var(--bg2)',
            borderLeft: '1px solid var(--border)',
            overflow: 'auto',
            display: 'flex',
            flexDirection: 'column',
          }}>
            <div style={{
              padding: '16px 20px',
              borderBottom: '1px solid var(--border)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
            }}>
              <div>
                <div style={{ fontWeight: 700, fontSize: 14 }}>Run Detail</div>
                <div style={{ fontFamily: 'var(--font-mono)', fontSize: 11, color: 'var(--accent2)', marginTop: 2 }}>
                  {selectedRun.id}
                </div>
              </div>
              <button onClick={() => setSelectedRun(null)} style={{ color: 'var(--text2)', fontSize: 18 }}>×</button>
            </div>

            <div style={{ padding: '16px 20px', borderBottom: '1px solid var(--border)' }}>
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12 }}>
                {[
                  ['Agent', selectedRun.agent_id],
                  ['Status', ''],
                  ['Tokens', (selectedRun.total_tokens ?? 0).toLocaleString()],
                  ['Version', selectedRun.agent_version ?? '—'],
                  ['Created', selectedRun.created_at ? new Date(selectedRun.created_at).toLocaleString() : '—'],
                  ['Correlation', selectedRun.correlation_id ? selectedRun.correlation_id.slice(0, 12) + '…' : '—'],
                ].map(([label, value], i) => (
                  <div key={i}>
                    <div style={{ fontSize: 11, color: 'var(--text2)', marginBottom: 4, textTransform: 'uppercase', letterSpacing: '0.05em' }}>{label}</div>
                    {label === 'Status' ? <Badge status={selectedRun.status} /> : <div style={{ fontSize: 13, fontFamily: label === 'Correlation' ? 'var(--font-mono)' : undefined }}>{value}</div>}
                  </div>
                ))}
              </div>
            </div>

            {selectedRun.output_json && (
              <div style={{ padding: '16px 20px', borderBottom: '1px solid var(--border)' }}>
                <div style={{ fontSize: 11, color: 'var(--text2)', marginBottom: 8, textTransform: 'uppercase', letterSpacing: '0.05em' }}>Output</div>
                <pre style={{
                  fontFamily: 'var(--font-mono)', fontSize: 12, color: 'var(--text)',
                  background: 'var(--bg3)', padding: 12, borderRadius: 6,
                  overflow: 'auto', maxHeight: 120, whiteSpace: 'pre-wrap', wordBreak: 'break-word',
                }}>
                  {(() => { try { return JSON.stringify(JSON.parse(selectedRun.output_json!), null, 2); } catch { return selectedRun.output_json; } })()}
                </pre>
              </div>
            )}

            {selectedRun.error_message && (
              <div style={{ padding: '16px 20px', borderBottom: '1px solid var(--border)' }}>
                <div style={{ fontSize: 11, color: '#ef4444', marginBottom: 8, textTransform: 'uppercase', letterSpacing: '0.05em' }}>Error</div>
                <pre style={{
                  fontFamily: 'var(--font-mono)', fontSize: 12, color: '#ef4444',
                  background: '#ef444411', padding: 12, borderRadius: 6,
                  overflow: 'auto', maxHeight: 100, whiteSpace: 'pre-wrap',
                }}>
                  {selectedRun.error_message}
                </pre>
              </div>
            )}

            <div style={{ padding: '16px 20px', flex: 1 }}>
              <div style={{ fontSize: 11, color: 'var(--text2)', marginBottom: 12, textTransform: 'uppercase', letterSpacing: '0.05em' }}>
                Events ({runEvents.length})
              </div>
              {runEvents.length === 0 ? (
                <div style={{ color: 'var(--text2)', fontSize: 13 }}>No events</div>
              ) : runEvents.map(ev => {
                const color = EVENT_COLOR[ev.type] ?? '#8888aa';
                let data: Record<string, unknown> = {};
                try { data = JSON.parse(ev.data_json) as Record<string, unknown>; } catch { /* empty */ }

                return (
                  <div key={ev.id} style={{ display: 'flex', gap: 10, marginBottom: 8, alignItems: 'flex-start' }}>
                    <div style={{ width: 8, height: 8, borderRadius: '50%', background: color, marginTop: 5, flexShrink: 0 }} />
                    <div style={{ flex: 1 }}>
                      <div style={{ display: 'flex', gap: 8, alignItems: 'center' }}>
                        <span style={{ fontFamily: 'var(--font-mono)', fontSize: 11, color }}>{ev.type}</span>
                        <span style={{ fontSize: 10, color: 'var(--text2)' }}>
                          {ev.timestamp ? new Date(ev.timestamp).toISOString().slice(11, 23) : ''}
                        </span>
                      </div>
                      {Object.keys(data).length > 0 && (
                        <div style={{ fontFamily: 'var(--font-mono)', fontSize: 10, color: 'var(--text2)', marginTop: 2 }}>
                          {JSON.stringify(data).slice(0, 120)}
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

