@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

/* ============================================================
   AGENT-OS GLASS SYSTEM — Deep Space / Luminous Interface
   Implements PRD: layered depth, frosted glass, ambient glows
   ============================================================ */

:root {
  /* --- Base depth layers --- */
  --bg:    #030712;
  --bg2:   #040b18;
  --bg3:   #071326;
  --bg4:   #0a1a33;

  /* --- Borders: luminous thin lines --- */
  --border:       rgba(99, 102, 241, 0.15);
  --border-glow:  rgba(99, 102, 241, 0.35);
  --border-cyan:  rgba(6, 182, 212, 0.25);

  /* --- Text hierarchy --- */
  --text:    #e2e8f0;
  --text2:   #64748b;
  --text3:   #334155;

  /* --- Accent palette --- */
  --accent:        #6366f1;
  --accent2:       #818cf8;
  --accent-glow:   rgba(99, 102, 241, 0.4);
  --cyan:          #06b6d4;
  --cyan-glow:     rgba(6, 182, 212, 0.3);
  --violet:        #8b5cf6;
  --violet-glow:   rgba(139, 92, 246, 0.3);

  /* --- Status --- */
  --green:   #22c55e;
  --red:     #ef4444;
  --yellow:  #f59e0b;
  --orange:  #f97316;

  /* --- Glass system --- */
  --glass-bg:       rgba(7, 19, 38, 0.6);
  --glass-bg-light: rgba(10, 26, 51, 0.7);
  --glass-border:   rgba(99, 102, 241, 0.18);
  --glass-blur:     blur(20px) saturate(1.6);
  --glass-blur-sm:  blur(12px) saturate(1.4);

  /* --- Spacing / radius --- */
  --radius:    14px;
  --radius-sm: 8px;
  --radius-lg: 20px;

  /* --- Typography --- */
  --font-sans: 'Syne', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: 'JetBrains Mono', 'Fira Code', monospace;
}

/* ============================================================
   RESET & BASE
   ============================================================ */

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body, #root {
  height: 100%;
  overflow: hidden;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

code, pre {
  font-family: var(--font-mono);
}

/* ============================================================
   AMBIENT BACKGROUND — nebula gradients + noise
   ============================================================ */

body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 80% 50% at 15% 20%,  rgba(99, 102, 241, 0.08) 0%, transparent 60%),
    radial-gradient(ellipse 60% 40% at 85% 75%,  rgba(6, 182, 212, 0.06) 0%, transparent 55%),
    radial-gradient(ellipse 50% 60% at 50% 100%, rgba(139, 92, 246, 0.05) 0%, transparent 50%);
}

body::after {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  background-repeat: repeat;
  background-size: 200px;
  opacity: 0.4;
}

#root {
  position: relative;
  z-index: 1;
}

/* ============================================================
   GLASS PANEL UTILITY
   ============================================================ */

.glass {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
}

.glass-light {
  background: var(--glass-bg-light);
  backdrop-filter: var(--glass-blur-sm);
  -webkit-backdrop-filter: var(--glass-blur-sm);
  border: 1px solid var(--glass-border);
}

/* ============================================================
   SCROLLBAR — thin luminous
   ============================================================ */

::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: rgba(99, 102, 241, 0.3);
  border-radius: 2px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(99, 102, 241, 0.6);
}

/* ============================================================
   BUTTONS — base reset
   ============================================================ */

button {
  border: none;
  background: none;
  cursor: pointer;
  font-family: var(--font-sans);
  font-size: inherit;
  color: inherit;
  transition: all 0.15s ease;
}

/* ============================================================
   HEADER — floating glass bar
   ============================================================ */

.dash-header {
  position: relative;
  height: 56px;
  padding: 0 24px;
  display: flex;
  align-items: center;
  gap: 16px;
  background: rgba(4, 11, 24, 0.8);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border-bottom: 1px solid var(--border);
  box-shadow: 0 1px 0 0 rgba(99, 102, 241, 0.08), 0 4px 24px rgba(0,0,0,0.4);
  flex-shrink: 0;
  z-index: 10;
}

.dash-header::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(99,102,241,0.4) 30%, rgba(6,182,212,0.3) 70%, transparent);
}

/* ============================================================
   LOGO MARK
   ============================================================ */

.logo-mark {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--accent) 0%, var(--violet) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: 800;
  color: #fff;
  box-shadow: 0 0 16px rgba(99,102,241,0.5), 0 2px 8px rgba(0,0,0,0.4);
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

.logo-mark::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255,255,255,0.15) 0%, transparent 100%);
  border-radius: 8px 8px 0 0;
}

/* ============================================================
   LIVE INDICATOR
   ============================================================ */

.live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #3f3f52;
  transition: all 0.3s ease;
  box-shadow: none;
}

.live-dot.active {
  background: var(--green);
  box-shadow: 0 0 6px var(--green), 0 0 12px rgba(34,197,94,0.4);
  animation: pulse-live 1s ease-out;
}

@keyframes pulse-live {
  0%   { transform: scale(1); }
  50%  { transform: scale(1.4); }
  100% { transform: scale(1); }
}

/* ============================================================
   PRIMARY BUTTON
   ============================================================ */

.btn-primary {
  padding: 6px 16px;
  background: linear-gradient(135deg, rgba(99,102,241,0.8) 0%, rgba(139,92,246,0.7) 100%);
  border: 1px solid rgba(99,102,241,0.5);
  color: #fff;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.02em;
  box-shadow: 0 0 12px rgba(99,102,241,0.25), 0 2px 6px rgba(0,0,0,0.3);
  transition: all 0.15s ease;
  backdrop-filter: var(--glass-blur-sm);
}

.btn-primary:hover {
  background: linear-gradient(135deg, rgba(99,102,241,0.95) 0%, rgba(139,92,246,0.9) 100%);
  box-shadow: 0 0 20px rgba(99,102,241,0.45), 0 4px 12px rgba(0,0,0,0.4);
  transform: translateY(-1px);
}

.btn-primary:active {
  transform: translateY(0);
}

.btn-danger {
  padding: 3px 10px;
  font-size: 11px;
  font-weight: 700;
  color: var(--orange);
  background: rgba(249,115,22,0.08);
  border: 1px solid rgba(249,115,22,0.3);
  border-radius: 6px;
  transition: all 0.15s;
}
.btn-danger:hover {
  background: rgba(249,115,22,0.15);
  box-shadow: 0 0 10px rgba(249,115,22,0.2);
}

.btn-approve {
  padding: 3px 10px;
  font-size: 11px;
  font-weight: 700;
  color: var(--green);
  background: rgba(34,197,94,0.08);
  border: 1px solid rgba(34,197,94,0.3);
  border-radius: 6px;
  transition: all 0.15s;
}
.btn-approve:hover {
  background: rgba(34,197,94,0.15);
  box-shadow: 0 0 10px rgba(34,197,94,0.2);
}

.btn-reject {
  padding: 3px 10px;
  font-size: 11px;
  font-weight: 700;
  color: var(--red);
  background: rgba(239,68,68,0.08);
  border: 1px solid rgba(239,68,68,0.3);
  border-radius: 6px;
  transition: all 0.15s;
}
.btn-reject:hover {
  background: rgba(239,68,68,0.15);
  box-shadow: 0 0 10px rgba(239,68,68,0.2);
}

.btn-secondary {
  padding: 5px 12px;
  background: rgba(99,102,241,0.1);
  border: 1px solid rgba(99,102,241,0.3);
  color: var(--accent2);
  border-radius: 6px;
  font-size: 12px;
  font-weight: 700;
  transition: all 0.15s;
}
.btn-secondary:hover {
  background: rgba(99,102,241,0.18);
  box-shadow: 0 0 12px rgba(99,102,241,0.2);
}

/* ============================================================
   STAT CARDS — glass + luminous numerics
   ============================================================ */

.stat-card {
  position: relative;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur-sm);
  -webkit-backdrop-filter: var(--glass-blur-sm);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius);
  padding: 14px 18px;
  flex: 1;
  min-width: 110px;
  overflow: hidden;
  transition: all 0.2s ease;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(99,102,241,0.5) 50%, transparent);
}

.stat-card:hover {
  border-color: rgba(99,102,241,0.35);
  box-shadow: 0 0 20px rgba(99,102,241,0.1), 0 4px 16px rgba(0,0,0,0.3);
  transform: translateY(-1px);
}

.stat-card__label {
  color: var(--text2);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.stat-card__value {
  font-size: 22px;
  font-weight: 800;
  color: var(--accent2);
  letter-spacing: -0.02em;
  line-height: 1;
  text-shadow: 0 0 20px rgba(129,140,248,0.4);
}

.stat-card__sub {
  color: var(--text2);
  font-size: 10px;
  margin-top: 4px;
  letter-spacing: 0.02em;
}

/* ============================================================
   TAB BAR — luminous indicator
   ============================================================ */

.tab-bar {
  display: flex;
  gap: 0;
  padding: 0 24px;
  background: rgba(4,11,24,0.7);
  backdrop-filter: var(--glass-blur-sm);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.tab-btn {
  padding: 13px 18px;
  font-size: 13px;
  font-weight: 700;
  color: var(--text2);
  border-bottom: 2px solid transparent;
  text-transform: capitalize;
  transition: color 0.15s, border-color 0.15s;
  display: flex;
  align-items: center;
  gap: 6px;
  letter-spacing: 0.01em;
  white-space: nowrap;
}

.tab-btn:hover {
  color: var(--text);
}

.tab-btn.active {
  color: var(--accent2);
  border-bottom-color: var(--accent);
  text-shadow: 0 0 12px rgba(129,140,248,0.5);
}

.tab-badge {
  background: rgba(245,158,11,0.9);
  color: #000;
  border-radius: 8px;
  font-size: 9px;
  font-weight: 800;
  padding: 1px 5px;
  min-width: 16px;
  text-align: center;
  box-shadow: 0 0 8px rgba(245,158,11,0.4);
}

/* ============================================================
   STATS BAR WRAPPER
   ============================================================ */

.stats-bar {
  padding: 10px 24px;
  display: flex;
  gap: 8px;
  flex-shrink: 0;
  overflow-x: auto;
  background: transparent;
}

/* ============================================================
   DATA TABLE — execution ledger
   ============================================================ */

.data-table {
  width: 100%;
  border-collapse: collapse;
}

.data-table thead tr {
  background: rgba(4,11,24,0.8);
  border-bottom: 1px solid var(--border);
}

.data-table th {
  padding: 10px 16px;
  text-align: left;
  font-size: 10px;
  color: var(--text2);
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  white-space: nowrap;
}

.data-table tbody tr {
  border-bottom: 1px solid rgba(99,102,241,0.07);
  transition: background 0.12s;
  cursor: pointer;
}

.data-table tbody tr:hover {
  background: rgba(99,102,241,0.05);
}

.data-table tbody tr.selected {
  background: rgba(99,102,241,0.08);
  box-shadow: inset 2px 0 0 var(--accent);
}

.data-table td {
  padding: 10px 16px;
}

/* ============================================================
   BADGE — status chips
   ============================================================ */

.badge {
  display: inline-block;
  padding: 2px 9px;
  border-radius: 5px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border: 1px solid transparent;
}

/* ============================================================
   EVENT TYPE CHIP
   ============================================================ */

.event-chip {
  font-family: var(--font-mono);
  font-size: 10px;
  padding: 2px 7px;
  border-radius: 4px;
}

/* ============================================================
   RUN DETAIL PANEL — glass side panel
   ============================================================ */

.detail-panel {
  flex: 0 0 45%;
  background: rgba(4,11,24,0.75);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border-left: 1px solid var(--border);
  overflow: auto;
  display: flex;
  flex-direction: column;
  animation: slide-in 0.18s ease;
}

@keyframes slide-in {
  from { transform: translateX(12px); opacity: 0; }
  to   { transform: translateX(0);    opacity: 1; }
}

.detail-panel__header {
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(7,19,38,0.5);
}

.detail-panel__close {
  width: 28px;
  height: 28px;
  border-radius: 7px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text2);
  font-size: 16px;
  transition: all 0.15s;
}
.detail-panel__close:hover {
  background: rgba(239,68,68,0.1);
  color: var(--red);
}

/* ============================================================
   OUTPUT / ERROR CODE BLOCKS
   ============================================================ */

.code-block {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text);
  background: rgba(3,7,18,0.8);
  border: 1px solid var(--border);
  padding: 12px;
  border-radius: 8px;
  overflow: auto;
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.6;
}

.code-block.error {
  color: var(--red);
  background: rgba(239,68,68,0.05);
  border-color: rgba(239,68,68,0.2);
}

/* ============================================================
   SECTION LABEL
   ============================================================ */

.section-label {
  font-size: 10px;
  color: var(--text2);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 700;
  margin-bottom: 8px;
}

/* ============================================================
   EVENT TIMELINE — in detail panel
   ============================================================ */

.event-timeline-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  margin-top: 5px;
  flex-shrink: 0;
  box-shadow: 0 0 6px currentColor;
}

/* ============================================================
   VIEW TOOLBAR (inside section headers)
   ============================================================ */

.view-toolbar {
  padding: 12px 24px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(4,11,24,0.5);
}

/* ============================================================
   APPROVAL PENDING ROW
   ============================================================ */

.approval-pending {
  background: rgba(245,158,11,0.04);
}

/* ============================================================
   EMPTY STATE
   ============================================================ */

.empty-state {
  padding: 56px 16px;
  text-align: center;
  color: var(--text2);
  font-size: 13px;
  line-height: 1.8;
}

.empty-state strong {
  color: var(--accent2);
  font-weight: 700;
}

/* ============================================================
   MONO TEXT HELPERS
   ============================================================ */

.mono {
  font-family: var(--font-mono);
}

.id-text {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--accent2);
}

/* ============================================================
   LOADING STATE
   ============================================================ */

.loading-state {
  padding: 48px;
  text-align: center;
  color: var(--text2);
  font-size: 13px;
  animation: pulse-text 1.5s ease-in-out infinite;
}

@keyframes pulse-text {
  0%, 100% { opacity: 0.5; }
  50%       { opacity: 1;   }
}

/* ============================================================
   PENDING APPROVAL WARNING
   ============================================================ */

.approval-warning {
  color: var(--yellow);
  font-weight: 700;
}