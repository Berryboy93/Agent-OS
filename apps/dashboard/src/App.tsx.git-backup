import React, { useEffect, useState, useCallback, useRef } from 'react';

interface Run {
  id: string;
  agent_id: string;
  status: 'PENDING' | 'RUNNING' | 'COMPLETED' | 'FAILED' | 'CANCELLED';
  input_json: string;
  output_json: string | null;
  error_message: string | null;
  total_tokens: number;
  started_at: number | null;
  completed_at: number | null;
  created_at: number;
}

interface AgentEvent {
  id: string;
  run_id: string;
  agent_id: string;
  type: string;
  data_json: string;
  timestamp: number;
  sequence_number: number;
}

interface Stats {
  runs: { total: number; byStatus: Array<{ status: string; count: number }> };
  tokens: { total: number };
  events: { lastHour: number };
}

const API = '/api';

function useInterval(fn: () => void, ms: number) {
  const cb = useRef(fn);
  useEffect(() => { cb.current = fn; });
  useEffect(() => {
    const id = setInterval(() => cb.current(), ms);
    return () => clearInterval(id);
  }, [ms]);
}

const STATUS_COLOR: Record<string, string> = {
  COMPLETED: '#22c55e',
  FAILED: '#ef4444',
  RUNNING: '#f59e0b',
  PENDING: '#6366f1',
  CANCELLED: '#8888aa',
};

const EVENT_COLOR: Record<string, string> = {
  'run.started': '#6366f1',
  'run.completed': '#22c55e',
  'run.failed': '#ef4444',
  'turn.started': '#3b82f6',
  'turn.completed': '#06b6d4',
  'tool.called': '#f59e0b',
  'tool.result': '#22c55e',
  'tool.error': '#ef4444',
  'token.usage': '#8888aa',
  'budget.exceeded': '#ef4444',
};

function Badge({ status }: { status: string }) {
  const color = STATUS_COLOR[status] ?? '#8888aa';
  return (
    <span style={{
      display: 'inline-block',
      padding: '2px 8px',
      borderRadius: 4,
      fontSize: 11,
      fontWeight: 600,
      background: color + '22',
      color,
      letterSpacing: '0.04em',
      textTransform: 'uppercase',
    }}>
      {status}
    </span>
  );
}

function StatCard({ label, value, sub }: { label: string; value: string | number; sub?: string }) {
  return (
    <div style={{
      background: 'var(--bg2)',
      border: '1px solid var(--border)',
      borderRadius: 'var(--radius)',
      padding: '20px 24px',
      flex: 1,
      minWidth: 140,
    }}>
      <div style={{ color: 'var(--text2)', fontSize: 12, marginBottom: 6, textTransform: 'uppercase', letterSpacing: '0.06em' }}>{label}</div>
      <div style={{ fontSize: 28, fontWeight: 700, color: 'var(--accent2)' }}>{value}</div>
      {sub && <div style={{ color: 'var(--text2)', fontSize: 12, marginTop: 4 }}>{sub}</div>}
    </div>
  );
}

function RunRow({ run, selected, onClick }: { run: Run; selected: boolean; onClick: () => void }) {
  const dur = run.completed_at && run.started_at
    ? ((run.completed_at - run.started_at) / 1000).toFixed(1) + 's'
    : run.status === 'RUNNING' ? '…' : '—';

  return (
    <tr
      onClick={onClick}
      style={{
        cursor: 'pointer',
        background: selected ? 'var(--bg3)' : 'transparent',
        borderBottom: '1px solid var(--border)',
        transition: 'background 0.1s',
      }}
    >
      <td style={{ padding: '10px 16px', fontFamily: 'var(--font-mono)', fontSize: 12, color: 'var(--accent2)' }}>
        {run.id.slice(0, 8)}
      </td>
      <td style={{ padding: '10px 16px', color: 'var(--text2)', fontSize: 13 }}>{run.agent_id}</td>
      <td style={{ padding: '10px 16px' }}><Badge status={run.status} /></td>
      <td style={{ padding: '10px 16px', fontFamily: 'var(--font-mono)', fontSize: 12, color: 'var(--text2)' }}>
        {run.total_tokens.toLocaleString()}
      </td>
      <td style={{ padding: '10px 16px', fontFamily: 'var(--font-mono)', fontSize: 12, color: 'var(--text2)' }}>
        {dur}
      </td>
      <td style={{ padding: '10px 16px', fontSize: 12, color: 'var(--text2)' }}>
        {run.created_at ? new Date(run.created_at).toLocaleTimeString() : '—'}
      </td>
    </tr>
  );
}

function EventRow({ event }: { event: AgentEvent }) {
  const color = EVENT_COLOR[event.type] ?? '#8888aa';
  let data: Record<string, unknown> = {};
  try { data = JSON.parse(event.data_json) as Record<string, unknown>; } catch { /* empty */ }
  const preview = Object.keys(data).length > 0
    ? JSON.stringify(data).slice(0, 100)
    : '';

  return (
    <tr style={{ borderBottom: '1px solid var(--border)' }}>
      <td style={{ padding: '8px 16px', fontFamily: 'var(--font-mono)', fontSize: 11, color: 'var(--text2)' }}>
        {event.timestamp ? new Date(event.timestamp).toISOString().slice(11, 23) : '—'}
      </td>
      <td style={{ padding: '8px 16px' }}>
        <span style={{
          fontFamily: 'var(--font-mono)',
          fontSize: 11,
          color,
          background: color + '18',
          padding: '2px 6px',
          borderRadius: 3,
        }}>
          {event.type}
        </span>
      </td>
      <td style={{ padding: '8px 16px', fontFamily: 'var(--font-mono)', fontSize: 11, color: 'var(--text2)', maxWidth: 300, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
        {preview}
      </td>
    </tr>
  );
}

export default function App() {
  const [tab, setTab] = useState<'runs' | 'events'>('runs');
  const [runs, setRuns] = useState<Run[]>([]);
  const [events, setEvents] = useState<AgentEvent[]>([]);
  const [stats, setStats] = useState<Stats | null>(null);
  const [selectedRun, setSelectedRun] = useState<Run | null>(null);
  const [runEvents, setRunEvents] = useState<AgentEvent[]>([]);
  const [loading, setLoading] = useState(true);
  const [liveIndicator, setLiveIndicator] = useState(false);

  const fetchRuns = useCallback(async () => {
    try {
      const r = await fetch(`${API}/runs?limit=50`);
      if (r.ok) setRuns(await r.json() as Run[]);
    } catch { /* ignore */ }
  }, []);

  const fetchEvents = useCallback(async () => {
    try {
      const r = await fetch(`${API}/events?limit=100`);
      if (r.ok) setEvents(await r.json() as AgentEvent[]);
    } catch { /* ignore */ }
  }, []);

  const fetchStats = useCallback(async () => {
    try {
      const r = await fetch(`${API}/stats`);
      if (r.ok) setStats(await r.json() as Stats);
    } catch { /* ignore */ }
  }, []);

  const fetchRunEvents = useCallback(async (runId: string) => {
    try {
      const r = await fetch(`${API}/runs/${runId}/events`);
      if (r.ok) setRunEvents(await r.json() as AgentEvent[]);
    } catch { /* ignore */ }
  }, []);

  useEffect(() => {
    Promise.all([fetchRuns(), fetchEvents(), fetchStats()]).finally(() => setLoading(false));
  }, [fetchRuns, fetchEvents, fetchStats]);

  useInterval(() => {
    fetchRuns();
    fetchStats();
  }, 5000);

  useEffect(() => {
    const es = new EventSource(`${API}/sse`);
    es.onmessage = (e) => {
      try {
        JSON.parse(e.data);
        setLiveIndicator(true);
        setTimeout(() => setLiveIndicator(false), 800);
        fetchRuns();
        fetchStats();
      } catch { /* ignore */ }
    };
    return () => es.close();
  }, [fetchRuns, fetchStats]);

  useEffect(() => {
    if (selectedRun) fetchRunEvents(selectedRun.id);
  }, [selectedRun, fetchRunEvents]);

  const handleSelectRun = (run: Run) => {
    setSelectedRun(prev => prev?.id === run.id ? null : run);
  };

  const spawnDemo = async () => {
    await fetch(`${API}/runs/demo`, { method: 'POST' });
    await Promise.all([fetchRuns(), fetchStats(), fetchEvents()]);
  };

  const statusCounts = stats?.runs.byStatus ?? [];
  const getCount = (s: string) => statusCounts.find(x => x.status === s)?.count ?? 0;

  return (
    <div style={{ display: 'flex', flexDirection: 'column', height: '100vh', overflow: 'hidden' }}>
      {/* Header */}
      <header style={{
        background: 'var(--bg2)',
        borderBottom: '1px solid var(--border)',
        padding: '0 24px',
        display: 'flex',
        alignItems: 'center',
        gap: 16,
        height: 56,
        flexShrink: 0,
      }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
          <div style={{
            width: 30, height: 30, borderRadius: 6,
            background: 'var(--accent)', display: 'flex', alignItems: 'center', justifyContent: 'center',
            fontSize: 16, fontWeight: 700,
          }}>A</div>
          <div>
            <div style={{ fontWeight: 700, fontSize: 15, letterSpacing: '-0.01em' }}>Agent-OS</div>
            <div style={{ fontSize: 10, color: 'var(--text2)', letterSpacing: '0.04em' }}>v2.0.0 · M0</div>
          </div>
        </div>

        <div style={{ flex: 1 }} />

        <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
          <span style={{
            width: 8, height: 8, borderRadius: '50%',
            background: liveIndicator ? '#22c55e' : '#3f3f52',
            transition: 'background 0.3s',
            display: 'inline-block',
          }} />
          <span style={{ fontSize: 11, color: 'var(--text2)' }}>LIVE</span>
        </div>

        <button
          onClick={spawnDemo}
          style={{
            padding: '6px 14px',
            background: 'var(--accent)',
            color: '#fff',
            borderRadius: 6,
            fontSize: 13,
            fontWeight: 600,
          }}
        >
          + Demo Run
        </button>
      </header>

      {/* Stats bar */}
      <div style={{
        background: 'var(--bg)',
        borderBottom: '1px solid var(--border)',
        padding: '12px 24px',
        display: 'flex',
        gap: 12,
        flexShrink: 0,
      }}>
        <StatCard label="Total Runs" value={stats?.runs.total ?? 0} />
        <StatCard label="Completed" value={getCount('COMPLETED')} sub="successful" />
        <StatCard label="Failed" value={getCount('FAILED')} sub="errors" />
        <StatCard label="Running" value={getCount('RUNNING')} sub="active" />
        <StatCard label="Total Tokens" value={(stats?.tokens.total ?? 0).toLocaleString()} sub="all time" />
        <StatCard label="Events (1h)" value={stats?.events.lastHour ?? 0} sub="last hour" />
      </div>

      {/* Tabs */}
      <div style={{
        background: 'var(--bg2)',
        borderBottom: '1px solid var(--border)',
        padding: '0 24px',
        display: 'flex',
        gap: 0,
        flexShrink: 0,
      }}>
        {(['runs', 'events'] as const).map(t => (
          <button
            key={t}
            onClick={() => setTab(t)}
            style={{
              padding: '12px 20px',
              fontSize: 13,
              fontWeight: 600,
              color: tab === t ? 'var(--accent2)' : 'var(--text2)',
              borderBottom: tab === t ? '2px solid var(--accent)' : '2px solid transparent',
              textTransform: 'capitalize',
              transition: 'color 0.15s',
            }}
          >
            {t}
          </button>
        ))}
      </div>

      {/* Main content */}
      <div style={{ display: 'flex', flex: 1, overflow: 'hidden' }}>
        {/* Table */}
        <div style={{ flex: selectedRun ? '0 0 55%' : 1, overflow: 'auto' }}>
          {loading ? (
            <div style={{ padding: 48, textAlign: 'center', color: 'var(--text2)' }}>Loading…</div>
          ) : tab === 'runs' ? (
            <table style={{ width: '100%', borderCollapse: 'collapse' }}>
              <thead>
                <tr style={{ background: 'var(--bg2)', borderBottom: '1px solid var(--border)' }}>
                  {['Run ID', 'Agent', 'Status', 'Tokens', 'Duration', 'Created'].map(h => (
                    <th key={h} style={{ padding: '10px 16px', textAlign: 'left', fontSize: 11, color: 'var(--text2)', fontWeight: 600, letterSpacing: '0.06em', textTransform: 'uppercase', whiteSpace: 'nowrap' }}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {runs.length === 0 ? (
                  <tr><td colSpan={6} style={{ padding: '48px 16px', textAlign: 'center', color: 'var(--text2)' }}>
                    No runs yet. Click <strong>+ Demo Run</strong> to create one.
                  </td></tr>
                ) : runs.map(run => (
                  <RunRow
                    key={run.id}
                    run={run}
                    selected={selectedRun?.id === run.id}
                    onClick={() => handleSelectRun(run)}
                  />
                ))}
              </tbody>
            </table>
          ) : (
            <table style={{ width: '100%', borderCollapse: 'collapse' }}>
              <thead>
                <tr style={{ background: 'var(--bg2)', borderBottom: '1px solid var(--border)' }}>
                  {['Time', 'Event Type', 'Data'].map(h => (
                    <th key={h} style={{ padding: '10px 16px', textAlign: 'left', fontSize: 11, color: 'var(--text2)', fontWeight: 600, letterSpacing: '0.06em', textTransform: 'uppercase' }}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {events.length === 0 ? (
                  <tr><td colSpan={3} style={{ padding: '48px 16px', textAlign: 'center', color: 'var(--text2)' }}>
                    No events yet.
                  </td></tr>
                ) : events.map(ev => <EventRow key={ev.id} event={ev} />)}
              </tbody>
            </table>
          )}
        </div>

        {/* Run detail panel */}
        {selectedRun && (
          <div style={{
            flex: '0 0 45%',
            background: 'var(--bg2)',
            borderLeft: '1px solid var(--border)',
            overflow: 'auto',
            display: 'flex',
            flexDirection: 'column',
          }}>
            <div style={{
              padding: '16px 20px',
              borderBottom: '1px solid var(--border)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
            }}>
              <div>
                <div style={{ fontWeight: 700, fontSize: 14 }}>Run Detail</div>
                <div style={{ fontFamily: 'var(--font-mono)', fontSize: 11, color: 'var(--accent2)', marginTop: 2 }}>
                  {selectedRun.id}
                </div>
              </div>
              <button onClick={() => setSelectedRun(null)} style={{ color: 'var(--text2)', fontSize: 18 }}>×</button>
            </div>

            <div style={{ padding: '16px 20px', borderBottom: '1px solid var(--border)' }}>
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12 }}>
                {[
                  ['Agent', selectedRun.agent_id],
                  ['Status', ''],
                  ['Tokens', selectedRun.total_tokens.toLocaleString()],
                  ['Created', selectedRun.created_at ? new Date(selectedRun.created_at).toLocaleString() : '—'],
                ].map(([label, value], i) => (
                  <div key={i}>
                    <div style={{ fontSize: 11, color: 'var(--text2)', marginBottom: 4, textTransform: 'uppercase', letterSpacing: '0.05em' }}>{label}</div>
                    {label === 'Status' ? <Badge status={selectedRun.status} /> : <div style={{ fontSize: 13 }}>{value}</div>}
                  </div>
                ))}
              </div>
            </div>

            {selectedRun.output_json && (
              <div style={{ padding: '16px 20px', borderBottom: '1px solid var(--border)' }}>
                <div style={{ fontSize: 11, color: 'var(--text2)', marginBottom: 8, textTransform: 'uppercase', letterSpacing: '0.05em' }}>Output</div>
                <pre style={{
                  fontFamily: 'var(--font-mono)',
                  fontSize: 12,
                  color: 'var(--text)',
                  background: 'var(--bg3)',
                  padding: 12,
                  borderRadius: 6,
                  overflow: 'auto',
                  maxHeight: 120,
                  whiteSpace: 'pre-wrap',
                  wordBreak: 'break-word',
                }}>
                  {(() => {
                    try { return JSON.stringify(JSON.parse(selectedRun.output_json!), null, 2); }
                    catch { return selectedRun.output_json; }
                  })()}
                </pre>
              </div>
            )}

            {selectedRun.error_message && (
              <div style={{ padding: '16px 20px', borderBottom: '1px solid var(--border)' }}>
                <div style={{ fontSize: 11, color: '#ef4444', marginBottom: 8, textTransform: 'uppercase', letterSpacing: '0.05em' }}>Error</div>
                <pre style={{
                  fontFamily: 'var(--font-mono)',
                  fontSize: 12,
                  color: '#ef4444',
                  background: '#ef444411',
                  padding: 12,
                  borderRadius: 6,
                  overflow: 'auto',
                  maxHeight: 100,
                  whiteSpace: 'pre-wrap',
                }}>
                  {selectedRun.error_message}
                </pre>
              </div>
            )}

            <div style={{ padding: '16px 20px', flex: 1 }}>
              <div style={{ fontSize: 11, color: 'var(--text2)', marginBottom: 12, textTransform: 'uppercase', letterSpacing: '0.05em' }}>
                Events ({runEvents.length})
              </div>
              {runEvents.length === 0 ? (
                <div style={{ color: 'var(--text2)', fontSize: 13 }}>No events</div>
              ) : runEvents.map(ev => {
                const color = EVENT_COLOR[ev.type] ?? '#8888aa';
                let data: Record<string, unknown> = {};
                try { data = JSON.parse(ev.data_json) as Record<string, unknown>; } catch { /* empty */ }

                return (
                  <div key={ev.id} style={{
                    display: 'flex',
                    gap: 10,
                    marginBottom: 8,
                    alignItems: 'flex-start',
                  }}>
                    <div style={{
                      width: 8, height: 8, borderRadius: '50%',
                      background: color, marginTop: 5, flexShrink: 0,
                    }} />
                    <div style={{ flex: 1 }}>
                      <div style={{ display: 'flex', gap: 8, alignItems: 'center' }}>
                        <span style={{ fontFamily: 'var(--font-mono)', fontSize: 11, color }}>{ev.type}</span>
                        <span style={{ fontSize: 10, color: 'var(--text2)' }}>
                          {ev.timestamp ? new Date(ev.timestamp).toISOString().slice(11, 23) : ''}
                        </span>
                      </div>
                      {Object.keys(data).length > 0 && (
                        <div style={{ fontFamily: 'var(--font-mono)', fontSize: 10, color: 'var(--text2)', marginTop: 2 }}>
                          {JSON.stringify(data).slice(0, 120)}
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
