{
  "color": {
    "background": {
      "deep": "#030712",
      "mid": "#040b18",
      "base": "#071326",
      "surface": "#0b1020",
      "elevated": "#12182b"
    },
    "accent": {
      "purple": "#8b5cf6",
      "green": "#22c55e",
      "blue": "#3b82f6",
      "amber": "#f59e0b",
      "red": "#ef4444",
      "cyan": "#06b6d4",
      "indigo": "#6366f1"
    },
    "text": {
      "primary": "#f1f5f9",
      "secondary": "#94a3b8",
      "tertiary": "#64748b",
      "muted": "#475569"
    }
  },
  "glass": {
    "background": {
      "default": "rgba(255,255,255,0.03)",
      "hover": "rgba(255,255,255,0.06)",
      "active": "rgba(255,255,255,0.08)",
      "strong": "rgba(255,255,255,0.06)"
    },
    "border": {
      "default": "rgba(255,255,255,0.08)",
      "hover": "rgba(255,255,255,0.14)",
      "active": "rgba(255,255,255,0.20)"
    },
    "blur": {
      "sm": "12px",
      "md": "18px",
      "lg": "24px",
      "xl": "32px"
    },
    "shadow": {
      "default": "0 4px 24px rgba(0,0,0,0.4)",
      "lg": "0 8px 32px rgba(0,0,0,0.5)",
      "inset": "inset 0 1px 1px rgba(255,255,255,0.08)"
    }
  },
  "spacing": {
    "grid": 4,
    "values": [
      4,
      8,
      12,
      16,
      24,
      32,
      48
    ]
  },
  "radius": {
    "sm": "10px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px"
  },
  "typography": {
    "fontFamily": {
      "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', 'SF Mono', monospace"
    },
    "sizes": {
      "xs": "10px",
      "sm": "11px",
      "md": "13px",
      "lg": "15px",
      "xl": "28px"
    }
  },
  "motion": {
    "duration": {
      "fast": "0.15s",
      "normal": "0.3s",
      "slow": "0.5s"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)"
