        print("  git status")
        print("  git diff")
        print("  pnpm -C apps/r3-agi exec tsc --noEmit")
        print("  pnpm -C apps/r3-agi run build")

    pending = [p for p, s in statuses.items() if s == "pending"]
    failed = [p for p, s in statuses.items() if s == "failed"]
    if failed:
        return 1
    if args.check and pending:
        return 1
    return 0


if __name__ == "__main__":
