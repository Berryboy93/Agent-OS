    # Summary
    print(f"\n{C.BLD}━━━ Summary ━━━{C.RST}")
    icon = {"clean": "✓", "patched": "✓", "pending": "●", "failed": "✗"}
    color = {"clean": C.GRN, "patched": C.GRN, "pending": C.YLW, "failed": C.RED}
    for phase, status in statuses.items():
        print(f"  {color[status]}{icon[status]}{C.RST} {phase}: {status}")

    print(f"\nMode: {C.GRN}APPLY{C.RST}" if args.apply else
          f"\nMode: {C.YLW}CHECK{C.RST}" if args.check else
          f"\nMode: {C.DIM}DRY-RUN{C.RST} (use --apply to commit)")

    if args.apply:
