    // ...inside create()(persist((set) => ({{ ... }}), {{ name: CHAT_KEY }})){C.RST}
"""

# ─── tsc verification ────────────────────────────────────────────────────────

def tsc_check(root: Path, label: str) -> tuple[bool, int]:
    info(f"Running tsc --noEmit ({label})...")
    rc, out = run_cmd(
        ["pnpm", "-C", APP_DIR, "exec", "tsc", "--noEmit"],
        cwd=root,
    )
    n_err = count_tsc_errors(out)
    if rc == 127:
        warn("  pnpm or tsc not found — skipping verification")
        return True, 0
    if rc == 124:
        warn("  tsc timed out — skipping")
        return True, 0
    if n_err == 0 and rc == 0:
        ok(f"  tsc clean ({label})")
        return True, 0
    err(f"  tsc reported {n_err} error(s) ({label})")
    print(out[-2000:])
    return False, n_err

# ─── Rollback ────────────────────────────────────────────────────────────────

def rollback(root: Path, backup_dir: Path) -> int:
    if not backup_dir.is_dir():
        err(f"backup dir not found: {backup_dir}")
        return 2
    info(f"Rolling back from {backup_dir}")
    n = 0
    for src in backup_dir.rglob("*"):
        if not src.is_file() or src.name == "MANIFEST.txt":
            continue
        rel = src.relative_to(backup_dir)
        dst = root / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)
        n += 1
        ok(f"  restored {rel}")
    ok(f"Rolled back {n} file(s)")
    return 0

# ─── Main ────────────────────────────────────────────────────────────────────

def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--apply", action="store_true", help="actually write changes")
    ap.add_argument("--check", action="store_true", help="CI mode: exit 1 if anything pending")
    ap.add_argument("--only", default="", help="comma-separated phase ids (p0-1,p0-3)")
    ap.add_argument("--skip-tsc", action="store_true", help="skip tsc verification")
