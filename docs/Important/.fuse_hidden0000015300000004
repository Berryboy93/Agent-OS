        ok(f"  tagged {tagged} use(s)")
        info(f"  next: open {PANEL_PATH} and replace each tagged block with useAGI actions")
        return "patched"
    return "pending"

SUGGESTED_CONV_SLICE = f"""
{C.DIM}    // suggested addition to store/useAGI.ts:
