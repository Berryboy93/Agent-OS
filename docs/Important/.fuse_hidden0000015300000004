    backups.save(PANEL_PATH)
    marker = "// TODO(p0-3): migrate to useAGI Zustand store; CONVO_STORAGE_KEY is the legacy split-brain key"
    src_lines = panel_text.splitlines()
    new_lines: list[str] = []
    tagged = 0
    for idx, line in enumerate(src_lines):
        # Idempotency: skip if previous emitted line already has the marker
        prev_emitted = new_lines[-1] if new_lines else ""
        if "CONVO_STORAGE_KEY" in line and "TODO(p0-3)" not in prev_emitted and "TODO(p0-3)" not in line:
