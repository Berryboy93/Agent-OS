        or "Conversation" in store_text
    )

    if not has_conv_slice:
        warn("  store/useAGI.ts does NOT yet have a conversations slice — manual extension required")
        info("  Add the following slice to useAGI.ts before re-running this phase:")
        print(SUGGESTED_CONV_SLICE)
        return "pending"

