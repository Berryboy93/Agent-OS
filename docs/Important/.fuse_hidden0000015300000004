#!/usr/bin/env python3
"""
fix-agi-suite-p0.py — WIRE.txt §14 compliant fixer for two P0 defects:

  P0-1: missing apps/r3-agi/tsconfig.json
  P0-3: split-brain chat persistence (CONVO_STORAGE_KEY in AgentSuitePanel.tsx
        vs CHAT_KEY in store/useAGI.ts)

Scope deliberately excludes P0-2 (api-client-react wiring) and P0-4
(double-wired /api/agent/chat) — those require the useAgentChat extraction,
which is a structural refactor, not a regex patch. See fix-agi-suite-p0-b.md
for the manual extraction guide.

Protocol (per Wire.txt):
  - Read targets before writing; print line-numbered preview
  - assert count == 1 anchor guards on every str_replace
  - Timestamped backups in .patch-backups/<utc>/
  - Dry-run default; --apply required to write
  - pnpm tsc --noEmit baseline before, verify after
  - Auto-rollback if tsc regressed
  - Idempotent: re-runs detect already-applied state and exit 0

Usage:
  ./fix-agi-suite-p0.py                    # dry-run, all phases
  ./fix-agi-suite-p0.py --apply            # write
  ./fix-agi-suite-p0.py --only=p0-1        # one defect at a time
  ./fix-agi-suite-p0.py --skip-tsc         # skip tsc verify (faster)
  ./fix-agi-suite-p0.py --rollback=<dir>   # restore from a backup dir

Exit codes:
  0  all targeted phases clean or applied successfully
  1  phase failed / regression detected / pending under --check
  2  preflight failed (wrong cwd, missing files)
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Optional

# ─── Configuration ──────────────────────────────────────────────────────────

REPO_ROOT_MARKER = "pnpm-workspace.yaml"
APP_DIR = "apps/r3-agi"
BACKUP_ROOT = ".patch-backups"

# P0-1 target
TSCONFIG_PATH = f"{APP_DIR}/tsconfig.json"
TSCONFIG_BASE_REL = "../../tsconfig.base.json"

# P0-3 targets
PANEL_PATH = f"{APP_DIR}/src/components/AgentSuitePanel.tsx"
STORE_PATH = f"{APP_DIR}/src/store/useAGI.ts"

# ─── Color helpers ──────────────────────────────────────────────────────────

def _supports_color() -> bool:
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") != "1"

C = type("C", (), {})()
if _supports_color():
    C.RED, C.GRN, C.YLW, C.BLU = "\033[31m", "\033[32m", "\033[33m", "\033[34m"
    C.MAG, C.CYN, C.DIM, C.BLD, C.RST = "\033[35m", "\033[36m", "\033[2m", "\033[1m", "\033[0m"
else:
    C.RED = C.GRN = C.YLW = C.BLU = C.MAG = C.CYN = C.DIM = C.BLD = C.RST = ""

def info(m): print(f"{C.BLU}[i]{C.RST} {m}")
def ok(m):   print(f"{C.GRN}[✓]{C.RST} {m}")
def warn(m): print(f"{C.YLW}[!]{C.RST} {m}", file=sys.stderr)
def err(m):  print(f"{C.RED}[✗]{C.RST} {m}", file=sys.stderr)
def hdr(n, sev, title): print(f"\n{C.BLD}━━━ {n} [{sev}] {title} ━━━{C.RST}")

# ─── Utilities ──────────────────────────────────────────────────────────────

def sha256(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:12]

def read_lines_with_numbers(path: Path, lo: int = 1, hi: Optional[int] = None) -> str:
    """WIRE.txt mandates: read with line numbers before writing."""
    lines = path.read_text().splitlines()
    if hi is None:
        hi = len(lines)
    width = len(str(hi))
    out = []
    for i, line in enumerate(lines[lo-1:hi], start=lo):
        out.append(f"  {str(i).rjust(width)} │ {line}")
    return "\n".join(out)

def assert_anchor_count(text: str, anchor: str, expected: int = 1, label: str = "") -> None:
    """WIRE.txt §6: every str_replace must validate anchor uniqueness."""
    n = text.count(anchor)
    if n != expected:
        raise SystemExit(
            f"ANCHOR ASSERTION FAILED: '{label or anchor[:50]}' "
            f"appeared {n} time(s), expected {expected}."
        )

def patch_str(path: Path, old: str, new: str, *, label: str, apply: bool) -> bool:
    """Replace a unique string with assertion guard. Returns True if changed."""
    text = path.read_text()
    if new in text and old not in text:
        info(f"  {label}: already applied (idempotent)")
        return False
    assert_anchor_count(text, old, 1, label)
    new_text = text.replace(old, new, 1)
    if new_text == text:
        return False
    if apply:
        path.write_text(new_text)
        ok(f"  {label}: patched ({sha256(text)} → {sha256(new_text)})")
    else:
        info(f"  {label}: would patch ({sha256(text)} → {sha256(new_text)})")
    return True

def run_cmd(cmd: list[str], cwd: Path, capture: bool = True) -> tuple[int, str]:
    """Run a subprocess; return (returncode, combined_output)."""
    try:
        r = subprocess.run(
            cmd, cwd=cwd,
            capture_output=capture, text=True, timeout=180,
        )
        return r.returncode, (r.stdout + r.stderr)
    except subprocess.TimeoutExpired:
        return 124, "<timeout>"
    except FileNotFoundError:
        return 127, f"<{cmd[0]} not found>"

def count_tsc_errors(output: str) -> int:
    # tsc lines like: "src/foo.ts(12,5): error TS2304: …"
    return sum(1 for line in output.splitlines() if "): error TS" in line)

# ─── Backups ─────────────────────────────────────────────────────────────────

class BackupSession:
    def __init__(self, repo_root: Path):
        ts = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        self.dir = repo_root / BACKUP_ROOT / ts
        self.repo_root = repo_root
        self.created = False

    def save(self, rel_path: str) -> None:
        src = self.repo_root / rel_path
        if not src.exists():
            return
        if not self.created:
            self.dir.mkdir(parents=True, exist_ok=True)
            self.created = True
        dst = self.dir / rel_path
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)

    def manifest(self) -> Path | None:
        if not self.created:
            return None
        m = self.dir / "MANIFEST.txt"
        files = sorted(p.relative_to(self.dir) for p in self.dir.rglob("*") if p.is_file() and p.name != "MANIFEST.txt")
        m.write_text("\n".join(str(f) for f in files) + "\n")
        return m

# ─── Preflight ───────────────────────────────────────────────────────────────

def find_repo_root(start: Path) -> Path:
    p = start.resolve()
    while p != p.parent:
        if (p / REPO_ROOT_MARKER).exists():
            return p
        p = p.parent
    raise SystemExit(2)

def preflight() -> Path:
    info("Preflight checks")
    try:
        root = find_repo_root(Path.cwd())
    except SystemExit:
        err(f"not in a pnpm monorepo (no {REPO_ROOT_MARKER} found upward from {Path.cwd()})")
        raise SystemExit(2)
    info(f"  repo root: {root}")

    if not (root / APP_DIR).is_dir():
        err(f"missing {APP_DIR}/ — wrong repo?")
        raise SystemExit(2)

    if not (root / "tsconfig.base.json").exists():
        warn(f"  {root}/tsconfig.base.json not found — P0-1 will skip 'extends' clause")

    ok("Preflight passed")
    return root

# ─── P0-1 ───────────────────────────────────────────────────────────────────

TSCONFIG_CONTENT = """{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
"""

def phase_p0_1(root: Path, apply: bool, backups: BackupSession) -> str:
    """Status: 'clean' | 'patched' | 'pending' | 'failed'."""
    hdr("P0-1", "🔴", "missing apps/r3-agi/tsconfig.json")
    target = root / TSCONFIG_PATH

    base_path = root / "tsconfig.base.json"
    content = TSCONFIG_CONTENT
    if not base_path.exists():
        # Strip the extends clause if base config absent
        content = content.replace('  "extends": "../../tsconfig.base.json",\n', "", 1)

    if target.exists():
        existing = target.read_text()
        if existing.strip() == content.strip():
            ok("  already exists with expected content (idempotent)")
            return "clean"
        warn(f"  {TSCONFIG_PATH} exists but differs from expected")
        info(f"  current content (first 20 lines):")
        print(read_lines_with_numbers(target, 1, 20))
        info(f"  not overwriting; remove the file manually if you want a fresh write")
        return "pending"

    info(f"  would create {TSCONFIG_PATH} ({len(content)} bytes)")
    if apply:
        target.write_text(content)
        ok(f"  created {TSCONFIG_PATH}")
        return "patched"
    return "pending"

# ─── P0-3 ───────────────────────────────────────────────────────────────────
#
# Goal: make Zustand store the single source of truth.
#
# Strategy: keep the CHAT_KEY in useAGI.ts as canonical. In AgentSuitePanel,
# replace direct localStorage.{get,set}Item(CONVO_STORAGE_KEY, …) calls with
# Zustand store actions, and remove the CONVO_STORAGE_KEY constant.
#
# Because the exact context of the localStorage calls can vary, this phase
# operates conservatively: it only patches lines that match expected anchors
# and emits a manual-action notice if the file shape has drifted.

def phase_p0_3(root: Path, apply: bool, backups: BackupSession) -> str:
    hdr("P0-3", "🔴", "split-brain chat persistence (CONVO_STORAGE_KEY)")
    panel = root / PANEL_PATH
    store = root / STORE_PATH

    if not panel.exists():
        err(f"  {PANEL_PATH} not found")
        return "failed"
    if not store.exists():
        err(f"  {STORE_PATH} not found")
        return "failed"

    panel_text = panel.read_text()
    store_text = store.read_text()

    # Idempotency check
    has_convo = "CONVO_STORAGE_KEY" in panel_text
    if not has_convo:
        ok("  CONVO_STORAGE_KEY no longer in AgentSuitePanel.tsx (already unified)")
        return "clean"

    # Discovery: report all touch points
    info("  Current CONVO_STORAGE_KEY references in AgentSuitePanel.tsx:")
    for i, line in enumerate(panel_text.splitlines(), 1):
        if "CONVO_STORAGE_KEY" in line:
            print(f"    {C.DIM}{str(i).rjust(5)}{C.RST} │ {line.strip()[:100]}")

    info("  Current CHAT_KEY references in store/useAGI.ts:")
    for i, line in enumerate(store_text.splitlines(), 1):
        if "CHAT_KEY" in line:
            print(f"    {C.DIM}{str(i).rjust(5)}{C.RST} │ {line.strip()[:100]}")

    # The actual patch is a structural change: AgentSuitePanel needs to
    # import setConversations / clearConversations actions from useAGI and
    # remove its localStorage paths. We can't safely regex-rewrite that
    # because the action names depend on what useAGI currently exports.
    #
    # What we CAN safely do:
    #   1. Verify useAGI.ts already has a conversations slice — if not,
    #      add a minimal one (separate phase, not done here).
    #   2. Mark CONVO_STORAGE_KEY uses with a // TODO(p0-3) comment so
    #      they're easy to find and resolve in editor.
