{
  "scripts": {
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --include='packages/*/src/**/*.test.ts'",
    "test:unit:watch": "vitest --watch --include='packages/*/src/**/*.test.ts'",
    "test:integration": "vitest run --include='packages/*/__tests__/**/*.test.ts' --bail 1",
    "test:integration:watch": "vitest --watch --include='packages/*/__tests__/**/*.test.ts'",
    "test:e2e": "vitest run --include='packages/*/__tests__/**/*.e2e.test.ts' --timeout 10000",
    "test:coverage": "vitest run --coverage",
    "test:coverage-check": "vitest run --coverage && node scripts/check-coverage-threshold.js",
    "test:perf": "vitest run --reporter=json --outputFile=perf-results.json packages/cli/__tests__/approval-workflow.test.ts",
    "test:perf:check": "node scripts/check-perf-regression.js --baseline .github/perf-baseline.json --current perf-results.json --threshold 10",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:coverage-check",
    "test:ci": "pnpm test:all && node scripts/validate-wire-compliance.js test-results/",
    "test:debug": "vitest --inspect-brk --inspect --single-thread",
    "build": "pnpm build:*",
    "build:cli": "tsc --project packages/cli/tsconfig.json",
    "build:runtime": "tsc --project packages/runtime/tsconfig.json",
    "build:dashboard": "tsc --project packages/dashboard/tsconfig.json",
    "db:migrate": "node scripts/migrate.js"
  }
}
