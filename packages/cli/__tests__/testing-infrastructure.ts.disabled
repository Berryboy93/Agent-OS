/**
 * @package testing infrastructure
 * Comprehensive vitest setup for Agent-OS monorepo
 * 
 * Files to create:
 * 1. vitest.config.ts (root) - already exists, update it
 * 2. vitest.workspace.ts (root) - monorepo configuration
 * 3. packages/*/vitest.config.ts - per-package overrides
 * 4. Test utilities and helpers
 * 5. Example test suites
 */

// ============================================================================
// 1. ROOT: vitest.workspace.ts
// ============================================================================
/**
 * Monorepo test configuration
 * Allows running all tests with: pnpm test
 */

import { defineWorkspace } from 'vitest/config';
import { getPackages } from '@manypkg/get-packages';

export default defineWorkspace(
  getPackages(process.cwd()).packages
    .filter(pkg => pkg.packageJson.name?.startsWith('@agent-os/') || pkg.dir.startsWith('apps/'))
    .map(pkg => ({
      test: {
        name: pkg.packageJson.name || pkg.dir,
        root: pkg.dir,
        include: ['**/__tests__/**/*.test.ts', '**/*.test.ts'],
        exclude: ['node_modules', 'dist'],
        globals: true,
        environment: 'node',
        coverage: {
          provider: 'v8',
          reporter: ['text', 'json', 'html'],
          exclude: [
            'node_modules/',
            'dist/',
            '**/__tests__/**',
            '**/*.test.ts',
            '**/*.spec.ts',
          ],
        },
      },
    }))
);

// ============================================================================
// 2. packages/*/vitest.config.ts TEMPLATE
// ============================================================================
/**
 * Individual package test config
 * Place in each package that needs tests
 */

import { defineConfig } from 'vitest/config';

export default defineConfig({
  test: {
    include: ['**/__tests__/**/*.test.ts', '**/*.test.ts'],
    exclude: ['node_modules', 'dist'],
    globals: true,
    environment: 'node',
    hookTimeout: 10_000,
    testTimeout: 10_000,
  },
});

// ============================================================================
// 3. TEST UTILITIES
// ============================================================================
/**
 * Create: packages/test-utils/src/index.ts
 * Shared testing utilities for all packages
 */

import { randomUUID } from 'crypto';

/**
 * Create a mock database client for testing
 */
export function createMockDb() {
  const data: Record<string, any[]> = {};

  return {
    select: () => ({
      from: (table: string) => {
        return data[table] || [];
      },
    }),
    insert: (table: string, record: any) => {
      if (!data[table]) data[table] = [];
      data[table].push({ id: randomUUID(), ...record });
      return { id: data[table][data[table].length - 1].id };
    },
    update: (table: string, record: any) => {
      if (!data[table]) return { changes: 0 };
      const index = data[table].findIndex(r => r.id === record.id);
      if (index >= 0) {
        data[table][index] = { ...data[table][index], ...record };
        return { changes: 1 };
      }
      return { changes: 0 };
    },
    delete: (table: string, id: string) => {
      if (!data[table]) return { changes: 0 };
      const index = data[table].findIndex(r => r.id === id);
      if (index >= 0) {
        data[table].splice(index, 1);
        return { changes: 1 };
      }
      return { changes: 0 };
    },
    clear: (table?: string) => {
      if (table) delete data[table];
      else Object.keys(data).forEach(t => delete data[t]);
    },
  };
}

/**
 * Create a mock event bus
 */
export function createMockEventBus() {
  const listeners: Record<string, Function[]> = {};
  const emitted: Array<{ event: string; data: any }> = [];

  return {
    on: (event: string, fn: Function) => {
      if (!listeners[event]) listeners[event] = [];
      listeners[event].push(fn);
    },
    emit: (event: string, data: any) => {
      emitted.push({ event, data });
      listeners[event]?.forEach(fn => fn(data));
    },
    getEmitted: () => emitted,
    clear: () => {
      emitted.length = 0;
      Object.keys(listeners).forEach(k => delete listeners[k]);
    },
  };
}

/**
 * Wait for a condition with timeout
 */
export async function waitFor(
  condition: () => boolean,
  timeoutMs: number = 5000,
  pollMs: number = 100
): Promise<void> {
  const startTime = Date.now();
  while (!condition()) {
    if (Date.now() - startTime > timeoutMs) {
      throw new Error(`Timeout waiting for condition after ${timeoutMs}ms`);
    }
    await new Promise(resolve => setTimeout(resolve, pollMs));
  }
}

/**
 * Create a test agent context
 */
export function createTestAgentContext() {
  return {
    agentId: randomUUID(),
    userId: randomUUID(),
    sessionId: randomUUID(),
    executionId: randomUUID(),
    timestamp: new Date(),
    metadata: {},
  };
}

