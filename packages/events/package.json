{
  "name": "@agent-os/events",
  "version": "3.0.0",
  "description": "Agent-OS append-only EventStore with 5-stage secret redaction",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
