{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "packages/*/src": ["packages/*/src"],
      "@r3/*": [
        "packages/*/src"
      ],
      "@agent-os/*": [
        "packages/*/dist"
      ],
      "@agi-ecosystem/*": [
        "packages/*/src"
      ]
    }
  }
}
